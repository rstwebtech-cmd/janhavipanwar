# Copy this file to ".env" for local testing.
# On Render, add these same values under Environment > Environment Variables.

# ---- Razorpay (get from https://dashboard.razorpay.com > Settings > API Keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Email (Gmail App Password recommended: https://myaccount.google.com/apppasswords) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your16digitapppassword

# ---- Where order/cancellation notifications are sent ----
OWNER_EMAIL=digitalscript07@gmail.com

# ---- Server ----
PORT=3000
